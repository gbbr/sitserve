{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitserve",
  "main": "worker/dev.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["enable_request_signal", "request_signal_passthrough"],
  // Cloudflare Access guards only the custom domain; no workers.dev or preview URL may bypass it.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/photo/*"]
  },
  "durable_objects": { "bindings": [{ "name": "UPSTREAM_GATE", "class_name": "UpstreamDurableObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UpstreamDurableObject"] }],
  "vars": {
    "UPSTREAM": "simulator",
    "SIMULATOR_DATE_SHIFT": "1",
    "UPSTREAM_SPACING_MS": "250",
    "SITE_URL": "http://localhost:8787"
  },
  "env": {
    "production": {
      "main": "worker/index.js",
      "routes": [{ "pattern": "os.sutamaya.org", "custom_domain": true }],
      "vars": { "UPSTREAM": "live", "SITE_URL": "https://os.sutamaya.org", "UPSTREAM_SPACING_MS": "1500" },
      "durable_objects": { "bindings": [{ "name": "UPSTREAM_GATE", "class_name": "UpstreamDurableObject" }] }
    }
  }
}
